#!/usr/bin/env python3
"""PreToolUse entry point: a worker is relaunched, never resumed.

The decision lives in `worker_resume`, which sits beside this file so the
tests can import it; running a script puts that directory on the path.
Registered in hooks.json on PreToolUse for SendMessage.
"""
import sys

import worker_resume

if __name__ == '__main__':
    sys.exit(worker_resume.main())
