#!/usr/bin/env python3
"""PostToolUse entry point: charge the parent for what a read returned.

The decision lives in `intake_ledger`, beside this file so the tests can
import it; running a script puts that directory on the path. Registered in
hooks.json on PostToolUse for Read and for Bash -- a Bash call is charged
only when check-bash-read marked it a reader first.

It judges nothing: the refusal is check-intake-budget's, on the next read.
"""
import sys

import intake_ledger

if __name__ == '__main__':
    try:
        sys.exit(intake_ledger.main('record'))
    except Exception:
        sys.exit(0)
