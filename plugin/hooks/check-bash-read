#!/usr/bin/env bash
# token-shunt PreToolUse hook for Bash (design §8, §10).
# Pass: exit 0, empty stdout. Deny: exit 0, permissionDecision JSON.
# Fail-closed: missing jq / unreadable stdin -> stderr + exit 2.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
  printf 'token-shunt: Bash 4 or newer is required; hook blocked\n' >&2
  exit 2
fi
export LC_ALL=C
HOOK_NAME=check-bash-read
HOOK_DIR=$(CDPATH= builtin cd -- "${BASH_SOURCE[0]%/*}" && pwd)
HOOK_SELF=${BASH_SOURCE[0]}

# --- common 1-2: jq required, stdin must be JSON ---
command -v jq >/dev/null 2>&1 || { printf 'token-shunt: jq is required\n' >&2; exit 2; }
input=$(cat)
jq -se 'length == 1 and (.[0] | type == "object")' >/dev/null 2>&1 <<<"$input" || { printf 'token-shunt: invalid hook stdin JSON\n' >&2; exit 2; }

# --- common 3: env thresholds ---
int_env() {
  local v=${!1-} d=$2
  v=${v#+}
  # >15 digits can wrap int64 arithmetic; treat as unset -> default.
  if [[ $v =~ ^-?[0-9]+$ ]] && (( ${#v} <= 15 )); then
    if [[ $v == -* ]]; then printf '%s' "$d"; else printf '%s' "$((10#$v))"; fi
  else
    printf '%s' "$d"
  fi
}
MIN_LINES=$(int_env TOKEN_SHUNT_MIN_LINES 350)
MIN_BYTES=$(int_env TOKEN_SHUNT_MIN_BYTES 65536)
SCAN_BUDGET_BYTES=$(int_env TOKEN_SHUNT_SCAN_BUDGET_BYTES 8388608)
SCAN_BUDGET_MS=$(int_env TOKEN_SHUNT_SCAN_BUDGET_MS 2000)

now_ms() {
  if [[ -n ${EPOCHREALTIME-} ]]; then
    local t=${EPOCHREALTIME/./}
    printf '%s' "$((10#${t%???}))"
  else
    local d
    d=$(date +%s%3N 2>/dev/null)
    [[ $d =~ ^[0-9]+$ ]] || d=$((SECONDS * 1000))
    printf '%s' "$d"
  fi
}

hook_log() {
  [[ -n ${TOKEN_SHUNT_HOOK_LOG-} ]] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  jq -c --arg h "$HOOK_NAME" --arg d "$1" --arg r "${2-}" \
    '{hook:$h,decision:$d,reason:$r,tool_use_id:.tool_use_id,session_id:.session_id,
      command:.tool_input.command}' <<<"$input" | python3 "$HOOK_DIR/write-hook-log" 3>&2 2>/dev/null || true
}
pass() { hook_log pass ""; exit 0; }
deny() {
  local reason=$1
  [[ $reason == *token-shunt* ]] || reason="token-shunt: $reason"
  hook_log deny "$reason"
  jq -nc --arg r "$reason" '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$r}}'
  exit 0
}

file_size() {
  # Match -f and the actual read: measure the target, not the symlink inode.
  local s
  s=$(stat -L -c %s -- "$1" 2>/dev/null) && { printf '%s' "$s"; return; }
  s=$(stat -L -f %z -- "$1" 2>/dev/null) && { printf '%s' "$s"; return; }
  return 1  # Never fall back to an unbounded content read.
}

# -> "exceeded undetermined lines bytes read_bytes elapsed_ms" (see check-file-size)
# Bound input before awk buffers a record; drain it to preserve pipeline status.
range_scan() {
  local path=$1 start=$2 count=$3 st t0 t1 elapsed res ex un rl rby rb
  st=$(file_size "$path") && [[ $st =~ ^[0-9]+$ ]] || { printf '1 1 0 0 0 0'; return; }
  t0=$(now_ms)
  res=$(set -o pipefail
    # One fixed EOF marker preserves exact newline accounting independent of stat.
    { head -c "$((SCAN_BUDGET_BYTES+1))" -- "$path" && printf '.'; } |
    awk -v start="$start" -v cnt="$count" -v ml="$MIN_LINES" -v mb="$MIN_BYTES" -v bb="$SCAN_BUDGET_BYTES" '
    function record(bytes) {
      if (f) return
      line++; rb+=bytes
      if (line>=start && line<start+cnt) {
        rl++; rby+=bytes
        if (rl>ml || rby>mb) { ex=1; f=1; return }
      }
      if (rb>bb) { ex=1; un=1; f=1; return }
      if (line==start+cnt-1) f=1
    }
    { if (NR>1) record(prev+1); prev=length($0) }
    END {
      if (prev>1) record(prev-1)
      printf "%d %d %d %d %d", ex, un, rl, rby, rb
    }') || res="1 1 0 0 0"
  t1=$(now_ms); elapsed=$((t1-t0))
  # Pipeline failures and malformed output are undetermined deny (§8.6).
  [[ $res =~ ^[01]\ [01]\ [0-9]+\ [0-9]+\ [0-9]+$ ]] || res="1 1 0 0 0"
  read -r ex un rl rby rb <<<"$res"
  if (( elapsed > SCAN_BUDGET_MS )); then ex=1; un=1; fi
  printf '%s %s %s %s %s %s' "$ex" "$un" "$rl" "$rby" "$rb" "$elapsed"
}

# tail_scan(path, N): last-N-line interval, same 6-field output (§8.6 tail rule).
tail_scan() {
  local path=$1 N=$2 t0 t1 el res last lines out_bytes ex=0 un=0
  t0=$(now_ms)
  # The last-byte probe preserves unterminated-line semantics without storing
  # file content in shell variables. Bound the suffix BEFORE line-based tail:
  # if its first record is incomplete, selecting it retains all budget+1 bytes
  # and is denied; selecting later records yields complete trailing lines.
  last=$(set -o pipefail; tail -c 1 -- "$path" | wc -l) || {
    printf '1 1 0 0 0 0'; return;
  }
  [[ $last =~ ^[[:space:]]*[01][[:space:]]*$ ]] || { printf '1 1 0 0 0 0'; return; }
  res=$(set -o pipefail
    tail -c "$((SCAN_BUDGET_BYTES+1))" -- "$path" |
    tail -n "$N" |
    awk -v last="$last" '{ bytes+=length($0)+1 }
      END { if (NR && !last) bytes--; printf "%d %d", NR, bytes }') || res=""
  t1=$(now_ms); el=$((t1-t0))
  [[ $res =~ ^[0-9]+\ [0-9]+$ ]] || { printf '1 1 0 0 0 %s' "$el"; return; }
  read -r lines out_bytes <<<"$res"
  (( lines > MIN_LINES || out_bytes > MIN_BYTES )) && ex=1
  if (( out_bytes > SCAN_BUDGET_BYTES || el > SCAN_BUDGET_MS )); then ex=1; un=1; fi
  printf '%s %s %s %s %s %s' "$ex" "$un" "$lines" "$out_bytes" "$out_bytes" "$el"
}

# -> "OK|EXCEEDED|UNDETERMINED lines bytes read_bytes elapsed_ms"
full_file_verdict() {
  local path=$1 st t0 t1 elapsed res v nl rb
  st=$(file_size "$path") && [[ $st =~ ^[0-9]+$ ]] || { printf 'UNDETERMINED 0 0 0 0'; return; }
  if (( st > MIN_BYTES )); then
    printf 'EXCEEDED -1 %s %s 0' "$st" "$st"; return
  fi
  t0=$(now_ms)
  res=$(set -o pipefail
    # Append one known byte so awk can distinguish the final unterminated
    # record without trusting stat (procfs and concurrent growth can report 0).
    { head -c "$((SCAN_BUDGET_BYTES+1))" -- "$path" && printf '.'; } |
    awk -v ml="$MIN_LINES" -v mb="$MIN_BYTES" -v bb="$SCAN_BUDGET_BYTES" '
    function record(bytes) {
      if (f) return
      lines++; rb+=bytes
      if (lines>ml || rb>mb) { v="EXCEEDED"; f=1 }
      else if (rb>bb) { v="UNDETERMINED"; f=1 }
    }
    { if (NR>1) record(prev+1); prev=length($0) }
    END {
      if (prev>1) record(prev-1)
      if (!f) v="OK"
      printf "%s %d %d %d", v, lines, rb, rb
    }') || res="UNDETERMINED 0 0 0"
  t1=$(now_ms); elapsed=$((t1-t0))
  # Pipeline failures and malformed output are undetermined deny (§8.6).
  [[ $res =~ ^(OK|EXCEEDED|UNDETERMINED)\ -?[0-9]+\ [0-9]+\ [0-9]+$ ]] || res="UNDETERMINED 0 0 0"
  read -r v nl rb _ <<<"$res"
  if [[ $v == OK ]] && (( elapsed > SCAN_BUDGET_MS )); then v=UNDETERMINED; fi
  printf '%s %s %s %s %s' "$v" "$nl" "$rb" "$rb" "$elapsed"
}

bash_reason() { # tool lines bytes read_bytes elapsed undetermined
  local tool=$1 ln=$2 by=$3 rd=$4 el=$5 un=$6 parts
  if [[ $ln == -1 ]]; then parts="bytes=${by}/${MIN_BYTES}"; else parts="lines=${ln}/${MIN_LINES}, bytes=${by}/${MIN_BYTES}"; fi
  printf "Bash '%s' on a large file exceeds token-shunt thresholds (%s). Use /token-shunt:bulk-reader. For edits, use a targeted Read of the original that passes the hook." "$tool" "$parts"
  if [[ $un == 1 ]]; then
    printf ' Scan budget exceeded (read_bytes=%s/%s, ms=%s/%s); use /token-shunt:bulk-reader for analysis. Editing still requires a successful targeted Read of the original.' "$rd" "$SCAN_BUDGET_BYTES" "$el" "$SCAN_BUDGET_MS"
  fi
}

# --- reader call contract (spec 2026-09-14 §4) ---
CONTRACT_FILE=$HOOK_DIR/reader-call-contract
CONTRACT_PATHS=()
CONTRACT_RAW=()

contract_add_path() { # absolute-path size-or-empty
  local abs=$1
  [[ $abs == /* ]] || abs=$PWD/$abs
  local existing
  for existing in ${CONTRACT_RAW[@]+"${CONTRACT_RAW[@]}"}; do
    [[ $existing == "$abs" ]] && return 0
  done
  CONTRACT_RAW+=("$abs")
  # A newline or CR in the path would break out of its line in the rendered
  # contract, indistinguishable from real contract text. Escape rather than
  # drop: the path stays recognizable and confined to a single line.
  local disp=$abs
  disp=${disp//$'\r'/\\r}
  disp=${disp//$'\n'/\\n}
  if [[ $2 =~ ^[0-9]+$ ]]; then
    CONTRACT_PATHS+=("$disp ($2 B)")
  else
    CONTRACT_PATHS+=("$disp (size unknown)")
  fi
}

# Fail closed to the current wording: a missing, unreadable, or malformed
# source of truth must never drop the deny itself.
render_contract() { # reason
  local body paths
  (( ${#CONTRACT_PATHS[@]} )) || return 1
  body=$(cat -- "$CONTRACT_FILE" 2>/dev/null) || return 1
  [[ $body == *'{REASON}'* && $body == *'{PATHS}'* ]] || return 1
  printf -v paths 'paths:\n%s' "$(printf '%s\n' "${CONTRACT_PATHS[@]}")"
  body=${body/'{REASON}'/"$1"}
  body=${body/'{PATHS}'/"$paths"}
  printf '%s' "$body"
}

# The template reason and the fallback reason are different texts: rendering
# failure must return the current wording, never the shortened template reason.
deny_contract() { # template-reason fallback-reason
  local rendered
  rendered=$(render_contract "$1") && deny "$rendered"
  deny "$2"
}

bash_contract_reason() { # tool lines bytes
  local parts
  if [[ $2 == -1 ]]; then parts="bytes=${3}/${MIN_BYTES}"
  else parts="lines=${2}/${MIN_LINES}, bytes=${3}/${MIN_BYTES}"; fi
  printf "Bash '%s' on a large file exceeds token-shunt thresholds (%s). For edits, use a targeted Read of the original that passes the hook." "$1" "$parts"
}

scan_budget_reason() { # read_bytes elapsed_ms
  printf 'Scan budget exceeded (read_bytes=%s/%s, ms=%s/%s); the size could not be established cheaply. For edits, use a targeted Read of the original that passes the hook.' \
    "$1" "$SCAN_BUDGET_BYTES" "$2" "$SCAN_BUDGET_MS"
}

# One collection point for every Bash deny that can be delegated: list all
# resolved operands, not just the one that tripped the check. The worker
# contract reads at most 3 explicit paths per call, so a wider operand list
# is a batch decision and stays on the skill route (return 1 -> no template).
contract_add_all_files() {
  local other sz
  (( ${#FILES[@]} >= 1 && ${#FILES[@]} <= 3 )) || return 1
  for other in "${FILES[@]}"; do
    check_parse_budget
    sz=$(file_size "$other") || sz=""
    contract_add_path "$other" "$sz"
  done
}

# --- common 4: worker allowlist (bulk-reader only; code-writer has no Bash) ---
# agent_type is harness-set at top level; tool_input is model-controlled.
agent=$(jq -r '.agent_type // empty' <<<"$input")
[[ $agent == token-shunt:bulk-reader ]] && pass

# Resolve tool-relative operands against the harness-provided directory.
if jq -e 'has("cwd")' >/dev/null <<<"$input"; then
  cwd=$(jq -ejr '.cwd | select(type == "string" and startswith("/") and (contains("\u0000") | not))' <<<"$input" && printf '.') || deny 'Invalid hook cwd.'
  cwd=${cwd%.}
  CDPATH= builtin cd -- "$cwd" 2>/dev/null || deny 'Hook cwd is unavailable.'
fi

# Cooperative guard also bounds dense commands with many subprocess probes.
# Individual blocked filesystem calls still require the harness timeout.
PARSE_DEADLINE=$((SECONDS + 3))
check_parse_budget() {
  (( SECONDS < PARSE_DEADLINE )) || deny 'Bash inspection time budget exceeded. Split the command into smaller calls.'
}

cmd=$(jq -r '.tool_input.command // empty' <<<"$input")
# Bound all per-character Bash parsing before comment/heredoc masking.
# Fixed (not model-configurable): oversized calls must be split by the caller.
(( ${#cmd} <= 8192 )) || deny 'Bash command exceeds the 8192-byte inspection limit. Split it into smaller calls.'
cmd="${cmd#"${cmd%%[![:space:]]*}"}"
cmd="${cmd%"${cmd##*[![:space:]]}"}"
[[ -z $cmd ]] && pass

# Remove shell comments before either operator scanning or tokenization. Keep
# newlines so a command following a comment remains a separate command.
strip_comments() {
  local s=$1 i=0 n=${#1} qs=0 c nxt word=0 j dq dc delim hd line end trim body_i delimiter_quoted arithmetic_depth=0
  local -a heredocs=() heredoc_tabs=() heredoc_quoted=()
  COMMENT_FREE=''
  while (( i < n )); do
    (( i % 128 )) || check_parse_budget
    c=${s:i:1}; nxt=${s:i+1:1}
    if (( qs == 0 )) && [[ $c == '#' ]] && (( !word )); then
      while (( i < n )) && [[ ${s:i:1} != $'\n' ]]; do ((i++)); done
      continue
    fi
    # Arithmetic shifts are not heredoc operators. Track their parentheses
    # only to keep the body masker from swallowing following real commands.
    if (( qs == 0 )); then
      if [[ $c == '(' ]] && { (( arithmetic_depth )) || [[ $nxt == '(' ]]; }; then
        ((arithmetic_depth++))
      elif [[ $c == ')' ]] && (( arithmetic_depth )); then ((arithmetic_depth--)); fi
    fi
    # Heredoc contents are data, not additional shell command segments.
    # Record quote-removed delimiters without expanding or executing them.
    if (( qs == 0 && arithmetic_depth == 0 )) && [[ $c == '<' && $nxt == '<' && ${s:i+2:1} != '<' && ( $i == 0 || ${s:i-1:1} != '<' ) ]]; then
      j=$((i+2)); trim=0
      if [[ ${s:j:1} == '-' ]]; then trim=1; ((j++)); fi
      while [[ ${s:j:1} == ' ' || ${s:j:1} == $'\t' ]]; do ((j++)); done
      delim=''; dq=0; hd=0; delimiter_quoted=0
      while (( j < n )); do
        dc=${s:j:1}
        case $dq in
          1) [[ $dc == "'" ]] && dq=0 || delim+=$dc ;;
          2) if [[ $dc == '"' ]]; then dq=0
             elif [[ $dc == '\' && ( ${s:j+1:1} == '"' || ${s:j+1:1} == '\' || ${s:j+1:1} == '$' || ${s:j+1:1} == '`' || ${s:j+1:1} == $'\n' ) ]]; then
               ((j++)); [[ ${s:j:1} == $'\n' ]] || delim+=${s:j:1}
             else delim+=$dc; fi ;;
          0) case $dc in
               [[:space:]]|'|'|'&'|';'|'<'|'>'|'('|')') break ;;
               "'") dq=1; delimiter_quoted=1 ;;
               '"') dq=2; delimiter_quoted=1 ;;
               '\')
                 ((j++))
                 if [[ ${s:j:1} != $'\n' ]]; then delimiter_quoted=1; delim+=${s:j:1}; fi ;;
               '`') deny 'Complex heredoc delimiter cannot be checked safely. Quote the entire delimiter.' ;;
               '$')
                 if [[ ${s:j+1:1} == '(' ]]; then
                   deny 'Complex heredoc delimiter cannot be checked safely. Quote the entire delimiter.'
                 fi
                 if [[ ${s:j+1:1} == "'" || ${s:j+1:1} == '"' ]]; then
                   deny 'token-shunt: Expanded heredoc delimiters cannot be checked safely. Use a literal delimiter.'
                 fi
                 delim+=$dc ;;
               *) delim+=$dc ;;
             esac ;;
        esac
        hd=1; ((j++))
      done
      (( dq == 0 )) || deny "token-shunt: Unclosed heredoc delimiter cannot be checked safely."
      if (( hd )); then
        heredocs+=("$delim"); heredoc_tabs+=("$trim"); heredoc_quoted+=("$delimiter_quoted")
        # Delimiter words are never expanded by Bash. The body is masked, so
        # normalize this header too rather than misclassifying literal $D.
        COMMENT_FREE+="<<'TOKEN_SHUNT_HEREDOC'"
        i=$j; word=1; continue
      fi
    fi
    COMMENT_FREE+=$c
    if (( qs == 0 )) && [[ $c == $'\n' ]] && ((${#heredocs[@]})); then
      j=$((i+1))
      for ((hd=0; hd<${#heredocs[@]}; hd++)); do
        while (( j < n )); do
          end=$j
          while (( end < n )) && [[ ${s:end:1} != $'\n' ]]; do ((end++)); done
          line=${s:j:end-j}; j=$((end+1))
          # Bash joins backslash-newline in an unquoted body before checking
          # delimiters. Do not guess that grammar and hide following commands.
          if (( !heredoc_quoted[hd] )) && [[ $line == *'\' ]]; then
            deny "token-shunt: Continued unquoted heredoc bodies cannot be checked safely. Quote the delimiter."
          fi
          if (( heredoc_tabs[hd] )); then
            while [[ $line == $'\t'* ]]; do line=${line:1}; done
          fi
          [[ $line == "${heredocs[hd]}" ]] && break
          if (( !heredoc_quoted[hd] )); then
            # Quotes in a heredoc body are data. Only backslash protects $, `,
            # and backslash; active substitutions execute before the command.
            for ((body_i=0; body_i<${#line}; body_i++)); do
              dc=${line:body_i:1}
              if [[ $dc == '\' && ( ${line:body_i+1:1} == '$' || ${line:body_i+1:1} == '`' || ${line:body_i+1:1} == '\' ) ]]; then
                ((body_i++)); continue
              fi
              if [[ $dc == '`' || ( $dc == '$' && ${line:body_i+1:1} == '(' ) ]]; then
                deny 'Executable substitutions in an unquoted heredoc cannot be checked safely. Quote the delimiter.'
              fi
            done
          fi
        done
      done
      heredocs=(); heredoc_tabs=(); heredoc_quoted=(); i=$j; word=0
      continue
    fi
    case $qs in
      1) [[ $c == "'" ]] && qs=0 ;;
      2) if [[ $c == '"' ]]; then qs=0
         elif [[ $c == '\' && ( $nxt == '"' || $nxt == '\' || $nxt == '$' || $nxt == '`' || $nxt == $'\n' ) ]]; then
           COMMENT_FREE+=$nxt; ((i++))
         fi ;;
      0) case $c in
           '\') if [[ $nxt == $'\n' ]]; then
                     COMMENT_FREE=${COMMENT_FREE%?}
                   else COMMENT_FREE+=$nxt; word=1
                   fi
                   ((i++)) ;;
           "'") qs=1; word=1 ;;
           '"') qs=2; word=1 ;;
           [[:space:]]|'|'|'&'|';'|'('|')'|'<'|'>') word=0 ;;
           *) word=1 ;;
         esac ;;
    esac
    ((i++))
  done
}
strip_comments "$cmd"
cmd=$COMMENT_FREE
# Masked heredoc bodies can leave a final newline after one simple command.
# It is not a compound list; keep genuine internal command separators.
cmd="${cmd#"${cmd%%[![:space:]]*}"}"
cmd="${cmd%"${cmd##*[![:space:]]}"}"

# A stdout redirect is isolating only for a normal file or /dev/null.
# Follow links without reading their contents; unknown devices/FIFOs and
# destinations with expansion syntax receive the usual input-file check.
is_isolating_target() {
  local target=$1 resolved
  [[ -n $target ]] || return 1
  case $target in /dev/stdout|/dev/stderr|/dev/fd/*|/proc/*/fd/*) return 1;; esac
  case $target in *'$'*|*'`'*|*'~'*|*'<'*|*'>'*|*'*'*|*'?'*|*'['*|*'('*|*')'*|*'{'*) return 1;; esac
  # /dev/null first: the hook's own stderr is often /dev/null, and comparing
  # the target against it by inode would read a discarding redirect as one
  # that writes back to the caller.
  [[ $target -ef /dev/null ]] && return 0
  [[ $target -ef /dev/stdout || $target -ef /dev/stderr ]] && return 1
  resolved=$(readlink -f -- "$target" 2>/dev/null) || resolved=$target
  case $resolved in /dev/stdout|/dev/stderr|/dev/fd/*|/proc/*/fd/*|*'pipe:['*|*'socket:['*) return 1;; esac
  [[ $target -ef /dev/null ]] && return 0
  [[ -f $target ]] && return 0
  [[ ! -e $target && ! -L $target ]]
}

# --- §10-4: quote-aware operator scan ---
# Sets: S_UNINTERP, PIPES=("pos:len"), SEPS=("pos:len"), CLEAN_GT, SPECIAL_GT
scan_ops() {
  local s=$1
  local i=0 n=${#s} qs=0 c nxt prv
  S_PROCESS=0; S_EXPANSION=0; S_UNINTERP=0; PIPES=(); SEPS=(); CLEAN_GT=0; SPECIAL_GT=0
  while (( i < n )); do
    (( i % 128 )) || check_parse_budget
    c=${s:i:1}
    prv=''; (( i > 0 )) && prv=${s:i-1:1}
    nxt=${s:i+1:1}
    case $qs in
      1) [[ $c == "'" ]] && qs=0 ;;
      2) if [[ $c == '"' ]]; then qs=0
         elif [[ $c == '\' && ( $nxt == '"' || $nxt == '\' || $nxt == '$' || $nxt == '`' || $nxt == $'\n' ) ]]; then ((i++))
         elif [[ $c == '$' ]]; then S_EXPANSION=1; [[ $nxt == '(' ]] && S_UNINTERP=1
         elif [[ $c == '`' ]]; then S_UNINTERP=1; fi ;;
      3) qs=0 ;;
      0) case $c in
         "\\") qs=3 ;;
         "'")  qs=1 ;;
         '"')  qs=2 ;;
         '$')  S_EXPANSION=1; [[ $nxt == \( ]] && S_UNINTERP=1 ;;
         '`')  S_UNINTERP=1 ;;
         '|')  if   [[ $nxt == '|' ]]; then SEPS+=("$i:2"); ((i++))
               elif [[ $nxt == '&' ]]; then PIPES+=("$i:2"); ((i++))
               else PIPES+=("$i:1"); fi ;;
         '&')  if   [[ $nxt == '&' ]]; then SEPS+=("$i:2"); ((i++))
               elif [[ $nxt == '>' ]]; then SPECIAL_GT=1; ((i++))
               elif [[ $prv == '>' || $prv == '<' ]]; then :
               elif (( i == n - 1 )); then :  # trailing background & is not a compound separator (§10-4)
               else SEPS+=("$i:1"); fi ;;
         '<')  [[ $nxt == '(' ]] && S_PROCESS=1 ;;
         '*'|'?'|'['|'~'|'{') S_EXPANSION=1 ;;
         '>')  [[ $nxt == '(' ]] && S_PROCESS=1
               [[ $nxt == '>' || $nxt == '|' || $nxt == '&' ]] && ((i++)) ;;
         ';'|$'\n') SEPS+=("$i:1") ;;
       esac ;;
    esac
    ((i++))
  done
  (( qs == 1 || qs == 2 )) && S_UNINTERP=1
  # Lex once, then inspect redirect tokens. Re-lexing a growing prefix and
  # suffix for every > made repeated redirects exceed the hook timeout.
  local -a saved_toks=("${TOKS[@]}") saved_kinds=("${TOK_KINDS[@]}") saved_exp=("${TOK_EXP[@]}")
  local fd t
  tokenize "$s"
  for ((i=0; i<${#TOKS[@]}; i++)); do
    (( i % 16 )) || check_parse_budget
    if [[ ${TOK_KINDS[i]} == input_redirect ]]; then
      fd=${TOKS[i]%%<*}
      [[ $fd =~ ^0*1$ ]] && SPECIAL_GT=1
      ((i++)); continue
    fi
    [[ ${TOK_KINDS[i]} == redirect ]] || continue
    t=${TOKS[i]}; fd=${t%%>*}
    if [[ $t == *'>&' ]] || { (( i > 0 )) && [[ ${TOK_KINDS[i-1]} == operator && ${TOKS[i-1]} == '&' ]]; }; then
      SPECIAL_GT=1
    elif [[ -z $fd || $fd =~ ^0*1$ ]]; then
      if is_isolating_target "${TOKS[i+1]-}"; then CLEAN_GT=1
      else SPECIAL_GT=1; fi
    fi
    ((i++))
  done
  TOKS=("${saved_toks[@]}"); TOK_KINDS=("${saved_kinds[@]}"); TOK_EXP=("${saved_exp[@]}")
}

# tokenize: quote removal -> TOKS, with lexical kinds preserved in TOK_KINDS.
# Quoted/escaped operator characters remain words, never redirections.
tokenize() {
  local s=$1
  local i=0 n=${#s} qs=0 c nxt cur='' have=0 quoted=0
  TOKS=(); TOK_KINDS=(); TOK_EXP=()
  local expanded=0
  while (( i < n )); do
    (( i % 128 )) || check_parse_budget
    c=${s:i:1}; nxt=${s:i+1:1}
    case $qs in
      1) [[ $c == "'" ]] && qs=0 || { cur+=$c; have=1; } ;;
      2) if [[ $c == '"' ]]; then qs=0
         elif [[ $c == '\' && ( $nxt == '"' || $nxt == '\' || $nxt == '$' || $nxt == '`' || $nxt == $'\n' ) ]]; then
           [[ $nxt != $'\n' ]] && cur+=$nxt
           ((i++))
         else [[ $c == '$' ]] && expanded=1; cur+=$c; have=1; fi ;;
      3) cur+=$c; qs=0 ;;
      0) case $c in
         "\\") qs=3; have=1; quoted=1 ;;
         "'")  qs=1; have=1; quoted=1 ;;
         '"')  qs=2; have=1; quoted=1 ;;
         '&'|'|'|';'|'('|')')
              (( have )) && { TOK_EXP[${#TOKS[@]}]=$expanded; TOKS+=("$cur"); TOK_KINDS+=(word); }
              TOK_EXP[${#TOKS[@]}]=0; TOKS+=("$c"); TOK_KINDS+=(operator); cur=''; have=0; quoted=0; expanded=0 ;;
         '<'|'>') local redir='' kind=redirect
              [[ $c == '<' ]] && kind=input_redirect
              if (( have )); then
                # Bash allocates a descriptor for an unquoted {name} prefix.
                # It is neither a command word nor stdout; do not infer its
                # dynamic descriptor number or let it manufacture isolation.
                if (( !quoted )) && [[ $cur =~ ^\{[A-Za-z_][A-Za-z0-9_]*\}$ ]]; then
                  deny "token-shunt: Named file descriptors cannot be checked safely. Use literal descriptor numbers."
                fi
                if (( !quoted )) && [[ $cur =~ ^[0-9]+$ ]]; then redir=$cur
                else TOK_EXP[${#TOKS[@]}]=$expanded; TOKS+=("$cur"); TOK_KINDS+=(word); fi
              fi
              redir+=$c
              if [[ $c == '>' && ( $nxt == '>' || $nxt == '|' || $nxt == '&' ) ]] ||
                 [[ $c == '<' && ( $nxt == '<' || $nxt == '>' || $nxt == '&' ) ]]; then
                redir+=$nxt; ((i++))
                if [[ $redir == *'<<' && ( ${s:i+1:1} == '<' || ${s:i+1:1} == '-' ) ]]; then
                  redir+=${s:i+1:1}; ((i++))
                fi
              fi
              TOK_EXP[${#TOKS[@]}]=0; TOKS+=("$redir"); TOK_KINDS+=("$kind"); cur=''; have=0; quoted=0; expanded=0 ;;
         [[:space:]]) (( have )) && { TOK_EXP[${#TOKS[@]}]=$expanded; TOKS+=("$cur"); TOK_KINDS+=(word); cur=''; have=0; quoted=0; expanded=0; } ;;
         '$'|'*'|'?'|'['|'~'|'{') expanded=1; cur+=$c; have=1 ;;
         *) cur+=$c; have=1 ;;
       esac ;;
    esac
    ((i++))
  done
  (( have )) && { TOK_EXP[${#TOKS[@]}]=$expanded; TOKS+=("$cur"); TOK_KINDS+=(word); }
}

# Identify the simple command after assignments and prefix redirections.
# Preserve redirection order: command, prefix redirects, remaining operands.
# TOKS stays untouched for callers that need the original lexical sequence.
strip_vars() {
  local i=0 n=${#TOKS[@]} count
  local -a prefix=() kinds=()
  VTOKS=(); VTOK_KINDS=(); COMMAND_EXPANSION=0
  while (( i < n )); do
    (( i % 128 )) || check_parse_budget
    if [[ ${TOK_KINDS[i]} == word && ${TOKS[i]} =~ ^[A-Za-z_][A-Za-z0-9_]*\+?= ]]; then
      ((i++)); continue
    fi
    count=0
    if [[ ${TOK_KINDS[i]} == redirect || ${TOK_KINDS[i]} == input_redirect ]]; then
      count=2
    elif [[ ${TOK_KINDS[i]} == operator && ${TOKS[i]} == '&' && ${TOK_KINDS[i+1]-} == redirect ]]; then
      count=3
    fi
    (( count )) || break
    (( i + count <= n )) || return 0
    prefix+=("${TOKS[@]:i:count}"); kinds+=("${TOK_KINDS[@]:i:count}")
    ((i+=count))
  done
  (( i < n )) || return 0
  COMMAND_EXPANSION=${TOK_EXP[i]:-0}
  VTOKS=("${TOKS[i]}" "${prefix[@]}" "${TOKS[@]:i+1}")
  VTOK_KINDS=("${TOK_KINDS[i]}" "${kinds[@]}" "${TOK_KINDS[@]:i+1}")
  strip_prefix_words
}

# Words that run another command without being one. `time cat big` reads the
# file exactly as `cat big` does; judging the prefix as the command let every
# reader through behind one of them. Each entry says how to skip the prefix's
# own arguments; anything unrecognised stops the stripping, which leaves the
# call judged as it was before rather than guessed at.
strip_prefix_words() {
  local base rounds=0
  while (( ${#VTOKS[@]} )) && (( rounds++ < 8 )); do
    case ${VTOK_KINDS[0]} in
      word) ;;
      operator) case ${VTOKS[0]} in '('|'{'|')'|'}') ;; *) return 0 ;; esac ;;
      *) return 0 ;;
    esac
    base=${VTOKS[0]##*/}
    case $base in
      time)            _drop_prefix '-p' '' ;;
      command)         _drop_prefix '-p|-v|-V' '' ;;
      exec)            _drop_prefix '-c|-l' '-a' ;;
      nice|ionice)     _drop_prefix '-n?*|-c?*|--adjustment=*' '-n|-c|--adjustment' ;;
      stdbuf)          _drop_prefix '-i?*|-o?*|-e?*|--input=*|--output=*|--error=*' '-i|-o|-e' ;;
      env)             _drop_prefix '-i|-|--ignore-environment|-0|--null|*=*' '-u|--unset' ;;
      timeout)         _drop_prefix '--preserve-status|--foreground|-k?*|-s?*|--signal=*|--kill-after=*' '-k|-s|--signal|--kill-after' && _drop_duration ;;
      busybox|toybox)  _drop_prefix '' '' ;;
      # Syntax, not commands: without dropping these the reader behind them
      # is never seen. `(` and `{` arrive as operators, the rest as words.
      '!'|'('|'{'|')'|'}'|if|then|else|elif|fi|do|done|while|until|esac) _drop_prefix '' '' ;;
      sudo)            _drop_prefix '-b|-E|-H|-n|-P|-S|--background|--preserve-env|--non-interactive' '-u|-g|-p|-C|--user|--group' ;;
      *)               return 0 ;;
    esac || return 0
  done
}

# Drop the prefix word and the prefix's own options, leaving the command it
# runs at VTOKS[0]. `skip` lists options that stand alone, `takes` those that
# consume the next word. Returns 1 — stop stripping — on anything else that
# looks like an option, so an unfamiliar invocation is judged as before
# rather than guessed at.
_drop_prefix() { # <skip-glob> <takes-value-glob>
  local skip=$1 takes=$2 i=1 word matched
  while (( i < ${#VTOKS[@]} )); do
    [[ ${VTOK_KINDS[i]} == word ]] || break
    word=${VTOKS[i]}
    matched=0
    [[ -n $takes ]] && eval "case \$word in $takes) matched=2 ;; esac"
    (( matched )) || { [[ -n $skip ]] && eval "case \$word in $skip) matched=1 ;; esac"; }
    (( matched )) && { ((i+=matched)); continue; }
    [[ $word == -?* ]] && return 1
    break
  done
  _shift_vtoks "$i"
}

# timeout's duration operand, e.g. `timeout 5 cat big` or `timeout 1.5s ...`.
_drop_duration() {
  (( ${#VTOKS[@]} )) || return 1
  [[ ${VTOK_KINDS[0]} == word && ${VTOKS[0]} =~ ^[0-9]+([.][0-9]+)?[smhd]?$ ]] || return 1
  _shift_vtoks 1
}

_shift_vtoks() {
  local i=$1
  (( i < ${#VTOKS[@]} )) || { VTOKS=(); VTOK_KINDS=(); return 0; }
  VTOKS=("${VTOKS[@]:i}"); VTOK_KINDS=("${VTOK_KINDS[@]:i}")
}

split_at() { # str cuts... -> SPLIT
  local s=$1; shift; local last=0 pl p l
  SPLIT=()
  for pl in "$@"; do p=${pl%%:*}; l=${pl##*:}; SPLIT+=("${s:last:p-last}"); last=$((p+l)); done
  SPLIT+=("${s:last}")
}

# `cat <big` hands the command the same bytes as `cat big`; the file is a
# read source whichever side of the redirect it sits on. Only a plain `<`
# (optionally with a descriptor number) opens a file for reading: `<<`,
# `<<<` and `<&` name a heredoc, a string and a descriptor.
_redirect_source() { # index of the redirect token
  local i=$1 op=${TOKS[i]}
  [[ ${TOK_KINDS[i]} == input_redirect ]] || return 1
  [[ $op =~ ^[0-9]*\<$ ]] || return 1
  [[ -f ${TOKS[i+1]-} ]]
}

# FILES = regular-file args of TOKS[1:] (dash-flags and redirect targets removed).
# `--` ends option parsing: later dash-tokens are operands.
collect_file_args() {
  FILES=(); local i=1 n=${#TOKS[@]} t eoo=0
  while (( i < n )); do
    (( i % 128 )) || check_parse_budget
    t=${TOKS[i]}
    if [[ ${TOK_KINDS[i]} == redirect || ${TOK_KINDS[i]} == input_redirect ]]; then
      _redirect_source "$i" && FILES+=("${TOKS[i+1]}")
      ((i+=2)); continue
    fi
    if (( !eoo )) && [[ $t == -- ]];  then eoo=1; ((i++)); continue; fi
    if (( !eoo )) && [[ $t == -* ]];  then ((i++)); continue; fi
    [[ -f $t ]] && FILES+=("$t")
    ((i++))
  done
}

# `dd if=big` prints the file to stdout as surely as `cat big` does. It is
# bounded when the bytes go to a file (`of=`) or when bs*count keeps the
# output under the full-file threshold; an operand we cannot evaluate leaves
# the call judged at the full threshold.
run_dd() { # TOKS[0] is dd
  local i t key value bs='' count='' src='' to_file=0 bound
  for ((i=1; i<${#TOKS[@]}; i++)); do
    check_parse_budget
    [[ ${TOK_KINDS[i]} == word ]] || continue
    t=${TOKS[i]}; key=${t%%=*}; value=${t#*=}
    [[ $t == *=* ]] || continue
    case $key in
      if)          src=$value ;;
      of)          to_file=1 ;;
      bs|ibs|obs)  bs=$value ;;
      count)       count=$value ;;
    esac
  done
  (( to_file )) && pass
  [[ -n $src && -f $src ]] || pass
  if [[ $bs =~ ^[0-9]+$ && $count =~ ^[0-9]+$ && ${#bs} -le 15 && ${#count} -le 15 ]]; then
    bound=$(( 10#$bs * 10#$count ))
    (( bound <= MIN_BYTES )) && pass
  fi
  FILES=("$src"); check_files_full dd; pass
}

# Commands that put a whole file into the transcript in some other shape.
# Nothing in their options bounds the output, so each one is judged exactly
# as cat is. diff/sdiff/comm take two operands; either one can be the large
# file. A reader missing from this list is a hole, not a permission.
is_full_reader() {
  case $1 in
    cat|less|more|nl|od|xxd|base64|strings|rev|tac|fold|expand|unexpand|\
    pr|shuf|cut|paste|column|diff|sdiff|comm) return 0 ;;
  esac
  return 1
}

is_grep_reader() {
  case $1 in grep|egrep|fgrep|rg|ripgrep) return 0 ;; esac
  return 1
}

# grep prints matching lines, and a pattern that matches most of a large file
# prints most of it. Two things bound it: a flag that replaces the matches
# with a name, a count or an exit status, or a line cap of at most
# GREP_LINE_CAP -- the same number of lines the Grep tool's head_limit allows
# once a file's size is known (§26.5), so the two routes agree.
#
# A line cap counts only with a single file operand (-m is per file, so two
# operands mean twice the lines) and no context window, which is the Grep
# tool's rule as well. The cap can come from -m/--max-count or from a
# `| head -n N` at the end of the pipeline, which sets TAIL_LINE_BOUND.
GREP_LINE_CAP=20
grep_output_is_bounded() { # TOKS holds the command
  local i n=${#TOKS[@]} t eoo=0 files=0 context=0 cap='' next
  for ((i=1; i<n; i++)); do
    (( i % 128 )) || check_parse_budget
    [[ ${TOK_KINDS[i]} == word ]] || { ((i++)); continue; }
    t=${TOKS[i]}
    if (( eoo )); then [[ -f $t ]] && ((files++)); continue; fi
    next=${TOKS[i+1]-}
    case $t in
      --) eoo=1 ;;
      --count|--files-with-matches|--files-without-match|--quiet|--silent) return 0 ;;
      --max-count=*) cap=${t#--max-count=} ;;
      --max-count) ((i++)); cap=$next ;;
      --after-context*|--before-context*|--context*) context=1 ;;
      --*) ;;
      -m) ((i++)); cap=$next ;;
      -m?*) cap=${t#-m} ;;
      -[ABC]) context=1; ((i++)) ;;
      -[ABC]?*|-[0-9]*) context=1 ;;
      -?*) [[ ${t#-} == *[clLq]* ]] && return 0 ;;
      *) [[ -f $t ]] && ((files++)) ;;
    esac
  done
  (( context )) && return 1
  (( files <= 1 )) || return 1
  if [[ $cap =~ ^[0-9]+$ && ${#cap} -le 15 ]] && (( 10#$cap <= GREP_LINE_CAP )); then
    return 0
  fi
  (( ${TAIL_LINE_BOUND:-0} ))
}

# `... | head -n N` with N no larger than the grep line cap. Mirrors
# pipe_tail_ok, which accepts only byte bounds, for the one case where a line
# count is a real bound: grep output that is already limited to matches.
pipe_tail_line_bound() { # TOKS holds the tail stage
  local opts=0 val='' bad=0 files=0 i t eoo=0
  for (( i=1; i<${#TOKS[@]}; i++ )); do
    t=${TOKS[i]}
    if [[ ${TOK_KINDS[i]} != word ]]; then bad=1; continue; fi
    if (( !eoo )) && [[ $t == -- ]]; then eoo=1; continue; fi
    if (( eoo )); then ((files++)); continue; fi
    case $t in
      -q|--quiet)      ;;
      -n|--lines)      ((opts++)); ((i++)); val=${TOKS[i]-} ;;
      -n?*)            ((opts++)); val=${t:2} ;;
      --lines=*)       ((opts++)); val=${t#--lines=} ;;
      -[0-9]*)         ((opts++)); val=${t#-} ;;
      -*)              bad=1 ;;
      *)               ((files++)) ;;
    esac
  done
  (( bad == 0 && files == 0 && opts == 1 )) || return 1
  [[ $val =~ ^[0-9]+$ && ${#val} -le 15 ]] || return 1
  (( 10#$val <= GREP_LINE_CAP ))
}

# An interpreter reads whatever its program tells it to, and the program is
# usually a quoted string the tokenizer keeps in one word. Rather than parse
# another language, every word of the call is searched for a path that exists
# on disk, and each one is judged at the full threshold.
is_interpreter() {
  case $1 in
    sed|awk|gawk|mawk|nawk|perl|python|python2|python3|ruby|node|nodejs|php|\
    pwsh|powershell|bash|sh|dash|zsh|ksh) return 0 ;;
  esac
  return 1
}

# Interpreters whose first non-option operand is the program to run, not data
# it prints. `python3 big.py` runs a large script; it does not read it out.
interpreter_skips_script() {
  case $1 in
    perl|python|python2|python3|ruby|node|nodejs|php|bash|sh|dash|zsh|ksh) return 0 ;;
  esac
  return 1
}

# Split a word on the punctuation that surrounds a path in shell and in the
# languages above, then keep the pieces that name an existing file. Quoting
# has already been removed by the tokenizer.
scan_text_for_files() { # text; appends to FILES
  local text=$1 word
  local -a words=()
  text=${text//[\'\"(),;:=\[\]\{\}\`\$\&\|\<\>\!\?\*]/ }
  text=${text//$'\t'/ }; text=${text//$'\n'/ }
  IFS=' ' read -r -a words <<<"$text"
  for word in ${words[@]+"${words[@]}"}; do
    [[ -n $word && $word != -* && -f $word ]] && FILES+=("$word")
  done
}

# FILES for an interpreter call: every path mentioned anywhere in it, minus
# the program itself. `sed -i` edits in place and prints nothing.
interpreter_files() { # base; TOKS holds the command
  local base=$1 i n=${#TOKS[@]} t script_seen=0
  FILES=()
  for ((i=1; i<n; i++)); do
    (( i % 128 )) || check_parse_budget
    t=${TOKS[i]}
    if [[ ${TOK_KINDS[i]} != word ]]; then
      _redirect_source "$i" && FILES+=("${TOKS[i+1]}")
      ((i++)); continue
    fi
    case $base in
      sed|awk|gawk|mawk|nawk)
        case $t in -i*|--in-place*) FILES=(); return 1 ;; esac ;;
    esac
    if [[ $t != -* ]] && (( ! script_seen )) && interpreter_skips_script "$base"; then
      script_seen=1
      [[ -f $t ]] && continue
    fi
    scan_text_for_files "$t"
  done
  return 0
}

# `xargs -a big cmd` feeds the file's contents to the command as arguments,
# and a command such as echo prints them straight back. The file is read
# whole either way.
run_xargs() { # TOKS holds the command
  local i n=${#TOKS[@]} t
  FILES=()
  for ((i=1; i<n; i++)); do
    (( i % 128 )) || check_parse_budget
    if [[ ${TOK_KINDS[i]} != word ]]; then
      # xargs reads its argument list from stdin when -a is absent.
      _redirect_source "$i" && FILES+=("${TOKS[i+1]}")
      ((i++)); continue
    fi
    t=${TOKS[i]}
    case $t in
      -a|--arg-file) ((i++)); [[ -f ${TOKS[i]-} ]] && FILES+=("${TOKS[i]}") ;;
      -a?*)          [[ -f ${t#-a} ]] && FILES+=("${t#-a}") ;;
      --arg-file=*)  [[ -f ${t#--arg-file=} ]] && FILES+=("${t#--arg-file=}") ;;
    esac
  done
  ((${#FILES[@]})) && check_files_full xargs
  return 0
}

# `find ... -exec cat {} +` runs a reader over every match. The matches are
# not known here, so there is no size to measure and no bound to accept: an
# unbounded reader behind -exec is refused outright.
run_find_exec() { # TOKS holds the command
  local i j n=${#TOKS[@]} cmd
  local -a saved_toks saved_kinds exec_toks exec_kinds
  for ((i=1; i<n; i++)); do
    (( i % 128 )) || check_parse_budget
    [[ ${TOK_KINDS[i]} == word ]] || continue
    case ${TOKS[i]} in -exec|-execdir|-ok|-okdir) ;; *) continue ;; esac
    ((i++)); cmd=${TOKS[i]-}; cmd=${cmd##*/}
    [[ -n $cmd ]] || continue
    if is_full_reader "$cmd"; then
      deny "find ${TOKS[i-1]} runs '$cmd' on every match and its output has no bound. List the matches with -print, read what you need, or use /token-shunt:bulk-reader."
    fi
    if is_grep_reader "$cmd"; then
      exec_toks=(); exec_kinds=()
      for ((j=i; j<n; j++)); do
        [[ ${TOK_KINDS[j]} == word && ( ${TOKS[j]} == ';' || ${TOKS[j]} == '+' ) ]] && break
        exec_toks+=("${TOKS[j]}"); exec_kinds+=("${TOK_KINDS[j]}")
      done
      saved_toks=("${TOKS[@]}"); saved_kinds=("${TOK_KINDS[@]}")
      TOKS=("${exec_toks[@]}"); TOK_KINDS=("${exec_kinds[@]}")
      if ! grep_output_is_bounded; then
        TOKS=("${saved_toks[@]}"); TOK_KINDS=("${saved_kinds[@]}")
        deny "find ${TOKS[i-1]} runs '$cmd' on every match with no output bound. Add -l, -c or -q, or use /token-shunt:bulk-reader."
      fi
      TOKS=("${saved_toks[@]}"); TOK_KINDS=("${saved_kinds[@]}")
    fi
  done
  return 0
}

# A stage that is only redirections still consumes a file: `done <big` hands
# the whole file to the loop that just ended.
redirect_only_sources() { # VTOKS holds the stage
  local j
  FILES=()
  TOKS=("${VTOKS[@]}"); TOK_KINDS=("${VTOK_KINDS[@]}")
  for ((j=0; j<${#TOKS[@]}; j++)); do
    [[ ${TOK_KINDS[j]} == input_redirect ]] || continue
    _redirect_source "$j" && FILES+=("${TOKS[j+1]}")
  done
  ((${#FILES[@]})) && check_files_full read
  return 0
}

# A shell runs a program, and that program is an ordinary command line. Judge
# it with this same gate instead of guessing from the paths it mentions:
# `bash -c "wc -l big"` reports a number, `bash -c "cat big"` prints the file.
# Depth is capped so a chain of shells cannot loop; past the cap the caller
# falls back to the path scan every other interpreter gets.
BASH_DEPTH=${TOKEN_SHUNT_BASH_DEPTH:-0}
BASH_DEPTH_MAX=3

shell_program() { # base; prints the -c program, empty when there is none
  local base=$1 i n=${#TOKS[@]} t
  case $base in bash|sh|dash|zsh|ksh) ;; *) return 1 ;; esac
  for ((i=1; i<n; i++)); do
    [[ ${TOK_KINDS[i]} == word ]] || { ((i++)); continue; }
    t=${TOKS[i]}
    case $t in
      --) return 1 ;;
      -*c) ((i++)); [[ -n ${TOKS[i]-} ]] || return 1; printf '%s' "${TOKS[i]}"; return 0 ;;
      -*) ;;
      *) return 1 ;;
    esac
  done
  return 1
}

# Re-enter the hook on the inner program. A deny is forwarded verbatim so the
# caller sees the reason for the command it actually ran; a dependency failure
# stays fail-closed.
check_shell_program() { # program text
  local nested out ec
  nested=$(jq -c --arg c "$1" '.tool_input.command = $c' <<<"$input") || return 1
  out=$(printf '%s' "$nested" | TOKEN_SHUNT_BASH_DEPTH=$((BASH_DEPTH + 1)) \
        TOKEN_SHUNT_HOOK_LOG= "$HOOK_SELF"); ec=$?
  if (( ec != 0 )); then exit "$ec"; fi
  if [[ -n $out ]]; then
    hook_log deny 'nested shell program'
    printf '%s\n' "$out"
    exit 0
  fi
  return 0
}

check_files_full() { # toolname; deny on first exceeding/undetermined target
  local tool=$1 f v nl rb rd el
  for f in ${FILES[@]+"${FILES[@]}"}; do
    check_parse_budget
    read -r v nl rb rd el <<<"$(full_file_verdict "$f")"
    [[ $v == OK ]] && continue
    if [[ $v == UNDETERMINED ]]; then
      # Byte-budget overruns and scan failures are delegable. A time-budget
      # overrun is excluded by design 2026-09-14 5, so it keeps the current
      # wording; the elapsed value distinguishes them without changing the
      # verdict tuple.
      if (( el <= SCAN_BUDGET_MS )); then
        contract_add_all_files \
          && deny_contract "$(scan_budget_reason "$rd" "$el")" \
                           "$(bash_reason "$tool" "$nl" "$rb" "$rd" "$el" 1)"
      fi
      deny "$(bash_reason "$tool" "$nl" "$rb" "$rd" "$el" 1)"
    fi
    contract_add_all_files \
      && deny_contract "$(bash_contract_reason "$tool" "$nl" "$rb")" \
                       "$(bash_reason "$tool" "$nl" "$rb" "$rd" "$el" 0)"
    deny "$(bash_reason "$tool" "$nl" "$rb" "$rd" "$el" 0)"
  done
}

# head/tail file-arg mode (§10-7): parse TOKS[1:] -> FILES + size-opt fields
ht_parse() {
  FILES=(); HT_OPTS=0; HT_FORM=''; HT_VALUE=''; HT_BAD=0
  local i=1 n=${#TOKS[@]} t eoo=0
  while (( i < n )); do
    (( i % 128 )) || check_parse_budget
    t=${TOKS[i]}
    if [[ ${TOK_KINDS[i]} == redirect || ${TOK_KINDS[i]} == input_redirect ]]; then
      _redirect_source "$i" && FILES+=("${TOKS[i+1]}")
      ((i+=2)); continue
    fi
    if (( !eoo )) && [[ $t == -- ]]; then eoo=1; ((i++)); continue; fi
    if (( eoo )); then [[ -f $t ]] && FILES+=("$t"); ((i++)); continue; fi
    case $t in
      -q|-v|--quiet|--verbose) ;;
      -n|--lines)      ((HT_OPTS++)); HT_FORM=line; ((i++)); HT_VALUE=${TOKS[i]-} ;;
      -c|--bytes)      ((HT_OPTS++)); HT_FORM=byte; ((i++)); HT_VALUE=${TOKS[i]-} ;;
      -n?*)            ((HT_OPTS++)); HT_FORM=line; HT_VALUE=${t:2} ;;
      -c?*)            ((HT_OPTS++)); HT_FORM=byte; HT_VALUE=${t:2} ;;
      --lines=*)       ((HT_OPTS++)); HT_FORM=line; HT_VALUE=${t#--lines=} ;;
      --bytes=*)       ((HT_OPTS++)); HT_FORM=byte; HT_VALUE=${t#--bytes=} ;;
      -[0-9]*)         ((HT_OPTS++)); HT_FORM=line; HT_VALUE=${t:1} ;;
      +[0-9]*)         HT_BAD=1 ;;
      -*)              HT_BAD=1 ;;
      *)               [[ -f $t ]] && FILES+=("$t") ;;
    esac
    ((i++))
  done
}

# head/tail at pipe end (§10-4): pass only for a single interpretable -c C,
# C <= MIN_BYTES, reading pure stdin (no file args, no redirects)
pipe_tail_ok() {
  local opts=0 form='' val='' bad=0 files=0 i t eoo=0
  for (( i=1; i<${#TOKS[@]}; i++ )); do
    t=${TOKS[i]}
    if [[ ${TOK_KINDS[i]} != word ]]; then bad=1; continue; fi
    if (( !eoo )) && [[ $t == -- ]]; then eoo=1; continue; fi
    if (( eoo )); then ((files++)); continue; fi
    case $t in
      -q|-v|--quiet|--verbose) ;;
      -c|--bytes)      ((opts++)); form=byte; ((i++)); val=${TOKS[i]-} ;;
      -c?*)            ((opts++)); form=byte; val=${t:2} ;;
      --bytes=*)       ((opts++)); form=byte; val=${t#--bytes=} ;;
      -n|--lines|-n?*|--lines=*|-[0-9]*) ((opts++)); form=line ;;
      -*)              bad=1 ;;
      *)               ((files++)) ;;
    esac
  done
  (( bad == 0 && files == 0 && opts == 1 )) || return 1
  [[ $form == byte && $val =~ ^[0-9]+$ && ${#val} -le 15 ]] || return 1
  (( 10#$val <= MIN_BYTES ))
}

# Decide whether a stage can send file contents around the final byte limiter.
# This only tracks explicit output redirects and tee operands, never shell
# expansion or execution. Other shell grammar keeps the existing limited scope.
pipe_target_route() {
  local target=$1 descriptor=''
  case $target in
    /dev/stdout) descriptor=1 ;;
    /dev/stderr) descriptor=2 ;;
    /dev/fd/*) descriptor=${target#/dev/fd/} ;;
    /proc/self/fd/*) descriptor=${target#/proc/self/fd/} ;;
  esac
  if [[ $descriptor =~ ^[0-9]+$ ]]; then
    while [[ ${#descriptor} -gt 1 && $descriptor == 0* ]]; do descriptor=${descriptor#0}; done
    printf '%s' "${PIPE_FDS[$descriptor]-unknown}"
  elif is_isolating_target "$target"; then
    printf file
  else
    printf unknown
  fi
}

# Reuse the existing pure-stdin byte-bound rule for an intermediate stage.
# Output redirections change its destination, not the amount head/tail emits.
# Keep quoted operator words and input-redirection text as operands so they
# cannot manufacture a pure-stdin proof.
pipe_stage_byte_bound() {
  local base i
  local -a bounded_toks=() bounded_kinds=()
  tokenize "$1"; strip_vars
  base=${VTOKS[0]-}; base=${base##*/}
  case $base in head|tail) ;; *) return 1;; esac
  for ((i=0; i<${#VTOKS[@]}; i++)); do
    if [[ ${VTOK_KINDS[i]} == redirect ]]; then ((i++)); continue; fi
    if [[ ${VTOK_KINDS[i]} == operator && ${VTOKS[i]} == '&' && ${VTOK_KINDS[i+1]-} == redirect ]]; then
      continue
    fi
    bounded_toks+=("${VTOKS[i]}"); bounded_kinds+=("${VTOK_KINDS[i]}")
  done
  TOKS=("${bounded_toks[@]}"); TOK_KINDS=("${bounded_kinds[@]}")
  pipe_tail_ok
}

pipe_stage_bypasses_limit() {
  local stage=$1 connector=$2 i t rawfd fd operator target route source base both
  local -A PIPE_FDS=([1]=pipe [2]=parent)
  tokenize "$stage"; strip_vars
  TOKS=("${VTOKS[@]}"); TOK_KINDS=("${VTOK_KINDS[@]}")
  base=${TOKS[0]-}; base=${base##*/}
  for ((i=0; i<${#TOKS[@]}; i++)); do
    [[ ${TOK_KINDS[i]} == redirect || ${TOK_KINDS[i]} == input_redirect ]] || continue
    t=${TOKS[i]}; rawfd=${t%%[<>]*}; operator=${t#"$rawfd"}
    if [[ $operator == '<'* ]]; then fd=${rawfd:-0}; else fd=${rawfd:-1}; fi
    while [[ ${#fd} -gt 1 && $fd == 0* ]]; do fd=${fd#0}; done
    both=0
    if (( i > 0 )) && [[ ${TOK_KINDS[i-1]} == operator && ${TOKS[i-1]} == '&' ]]; then both=1; fi
    ((i++)); target=${TOKS[i]-}
    if [[ ( $operator == '>&' || $operator == '<&' ) && $target =~ ^[0-9]+-?$ ]]; then
      source=${target%-}
      while [[ ${#source} -gt 1 && $source == 0* ]]; do source=${source#0}; done
      route=${PIPE_FDS[$source]-unknown}
      [[ $target == *- ]] && PIPE_FDS[$source]=closed
    elif [[ ( $operator == '>&' || $operator == '<&' ) && $target == '-' ]]; then
      route=closed
    else
      route=$(pipe_target_route "$target")
      # Bash's >&word form without an explicit descriptor redirects both.
      [[ $operator == '>&' && -z $rawfd ]] && both=1
    fi
    PIPE_FDS[$fd]=$route
    (( both )) && PIPE_FDS[2]=$route
  done
  # |& duplicates the stage's final stdout onto stderr after explicit redirects.
  [[ $connector == '|&' ]] && PIPE_FDS[2]=${PIPE_FDS[1]}
  case ${PIPE_FDS[1]} in pipe|file|closed) ;; *) return 0;; esac
  if [[ $base == tee ]]; then
    local eoo=0
    for ((i=1; i<${#TOKS[@]}; i++)); do
      if [[ ${TOK_KINDS[i]} == redirect ]]; then ((i++)); continue; fi
      [[ ${TOK_KINDS[i]} == word ]] || continue
      t=${TOKS[i]}
      if (( !eoo )) && [[ $t == -- ]]; then eoo=1; continue; fi
      if (( !eoo )) && [[ $t == -* ]]; then continue; fi
      route=$(pipe_target_route "$t")
      case $route in pipe|file|closed) ;; *) return 0;; esac
    done
  fi
  return 1
}

run_head_tail() { # TOKS[0] is head|tail; per-target verdict
  local tool=${TOKS[0]##*/} f st actual ex un rl rby rd el probe t0 t1
  (( ${CMD_EXPANSION:-0} )) && deny "Shell-expanded file operands cannot be checked safely. Use literal paths with /token-shunt:bulk-reader."
  ht_parse
  if (( ${FS_UNCERTAIN:-0} )); then
    if ! (( HT_BAD == 0 && HT_OPTS == 1 )) || [[ $HT_FORM != byte || ! $HT_VALUE =~ ^[0-9]+$ || ${#HT_VALUE} -gt 15 ]] || (( 10#$HT_VALUE > MIN_BYTES )); then
      deny "A command in this Bash call may change reader files before execution. Use an explicit byte bound or separate preparation and reading with /token-shunt:bulk-reader."
    fi
  fi
  ((${#FILES[@]})) || pass
  if (( HT_BAD || HT_OPTS > 1 )); then
    check_files_full "$tool"; pass
  fi
  if (( HT_OPTS == 0 )); then HT_FORM=line; HT_VALUE=10; fi
  if ! [[ $HT_VALUE =~ ^[0-9]+$ ]] || (( ${#HT_VALUE} > 15 )); then
    check_files_full "$tool"; pass   # uninterpretable -> full threshold
  fi
  if [[ $HT_FORM == line ]]; then
    (( 10#$HT_VALUE == 0 )) && pass
    for f in ${FILES[@]+"${FILES[@]}"}; do
    check_parse_budget
      if [[ $tool == head ]]; then
        read -r ex un rl rby rd el <<<"$(range_scan "$f" 1 "$((10#$HT_VALUE))")"
      else
        read -r ex un rl rby rd el <<<"$(tail_scan "$f" "$((10#$HT_VALUE))")"
      fi
      (( ex )) || continue
      if (( un )); then
        if (( el <= SCAN_BUDGET_MS )); then
          contract_add_all_files \
            && deny_contract "$(scan_budget_reason "$rd" "$el")" \
                             "$(bash_reason "$tool" "$rl" "$rby" "$rd" "$el" 1)"
        fi
        deny "$(bash_reason "$tool" "$rl" "$rby" "$rd" "$el" 1)"
      fi
      contract_add_all_files \
        && deny_contract "$(bash_contract_reason "$tool" "$rl" "$rby")" \
                         "$(bash_reason "$tool" "$rl" "$rby" "$rd" "$el" 0)"
      deny "$(bash_reason "$tool" "$rl" "$rby" "$rd" "$el" 0)"
    done
  else
    for f in ${FILES[@]+"${FILES[@]}"}; do
    check_parse_budget
      # An explicit byte bound is sufficient regardless of the file size.
      (( 10#$HT_VALUE <= MIN_BYTES )) && continue
      if ! { st=$(file_size "$f") && [[ $st =~ ^[0-9]+$ ]]; }; then
        # No elapsed measurement has happened yet at this point in the loop;
        # treat it as 0, which is always <= SCAN_BUDGET_MS -> templates as a
        # scan failure (the file's size could not be established cheaply).
        contract_add_all_files \
          && deny_contract "$(scan_budget_reason 0 0)" \
                           "$(bash_reason "$tool" 0 0 0 0 1)"
        deny "$(bash_reason "$tool" 0 0 0 0 1)"
      fi
      if (( st > MIN_BYTES )); then
        contract_add_all_files \
          && deny_contract "$(bash_contract_reason "$tool" -1 "$st")" \
                           "$(bash_reason "$tool" 0 "$st" 0 0 0)"
        deny "$(bash_reason "$tool" 0 "$st" 0 0 0)"
      fi
      # A small stat is not proof of a small output (procfs, concurrent growth).
      # Both head and tail emit min(C, actual file bytes), so a bounded prefix
      # establishes the size without buffering content or reading a long suffix.
      probe=$(( (MIN_BYTES < SCAN_BUDGET_BYTES ? MIN_BYTES : SCAN_BUDGET_BYTES) + 1 ))
      t0=$(now_ms)
      actual=$(set -o pipefail; head -c "$probe" -- "$f" | wc -c) || {
        contract_add_all_files \
          && deny_contract "$(scan_budget_reason 0 0)" \
                           "$(bash_reason "$tool" 0 0 0 0 1)"
        deny "$(bash_reason "$tool" 0 0 0 0 1)"
      }
      actual=${actual//[[:space:]]/}
      if ! [[ $actual =~ ^[0-9]+$ ]]; then
        contract_add_all_files \
          && deny_contract "$(scan_budget_reason 0 0)" \
                           "$(bash_reason "$tool" 0 0 0 0 1)"
        deny "$(bash_reason "$tool" 0 0 0 0 1)"
      fi
      t1=$(now_ms); el=$((t1-t0))
      if (( actual > MIN_BYTES )); then
        contract_add_all_files \
          && deny_contract "$(bash_contract_reason "$tool" -1 "$actual")" \
                           "$(bash_reason "$tool" 0 "$actual" "$actual" "$el" 0)"
        deny "$(bash_reason "$tool" 0 "$actual" "$actual" "$el" 0)"
      fi
      if (( actual > SCAN_BUDGET_BYTES )) && (( el <= SCAN_BUDGET_MS )); then
        contract_add_all_files \
          && deny_contract "$(scan_budget_reason "$actual" "$el")" \
                           "$(bash_reason "$tool" 0 "$actual" "$actual" "$el" 1)"
      fi
      (( actual > SCAN_BUDGET_BYTES || el > SCAN_BUDGET_MS )) \
        && deny "$(bash_reason "$tool" 0 "$actual" "$actual" "$el" 1)"
    done
  fi
  pass
}

# A file-size observation is usable only before any potentially mutating stage.
# This is deliberately a small proof of harmless stages, not a writer blacklist.
stage_may_mutate() {
  local raw=$1 base kind i token target arithmetic_safe
  # Even a metadata command may execute substitutions before it starts.
  arithmetic_safe=$raw
  # Numeric-only arithmetic cannot execute a command or assign shell state.
  while [[ $arithmetic_safe =~ \$\(\([0-9[:space:]()+*/%\<\>\&\|^~!-]+\)\) ]]; do
    arithmetic_safe=${arithmetic_safe/"${BASH_REMATCH[0]}"/0}
  done
  case $arithmetic_safe in *'$'*|*'`'*) return 0;; esac
  tokenize "$raw"; strip_vars
  base=${VTOKS[0]-}; base=${base##*/}
  for ((i=0; i<${#TOKS[@]}; i++)); do
    kind=${TOK_KINDS[i]}; token=${TOKS[i]}; target=${TOKS[i+1]-}
    if [[ $kind == redirect ]]; then
      if [[ $token == *'>&' && $target =~ ^[0-9]+-?$ ]] || [[ $target == /dev/null ]]; then
        ((i++)); continue
      fi
      return 0
    elif [[ $kind == input_redirect && $token == *'<>' ]]; then return 0
    fi
  done
  case $base in
    cat|head|tail|less|more|wc|grep|stat|true|false|pwd|echo|printf) return 1;;
    cd) (( ${TRACK_CD:-0} && ! ${CD_UNCERTAIN:-0} )) && return 1;;
    '') return 1;;
  esac
  return 0
}

check_command_expansion() {
  tokenize "$1"; strip_vars
  (( COMMAND_EXPANSION )) && deny "Shell-expanded command words cannot be checked safely. Use a literal command name or /token-shunt:bulk-reader."
  return 0
}

# evaluate one simple command at the FULL threshold (compound segments,
# pipeline first command after non-narrowing tail, uninterpretable commands)
check_stage_full() {
  local base unresolved inner
  scan_ops "$1"; unresolved=$S_EXPANSION
  tokenize "$1"; strip_vars
  ((${#VTOKS[@]})) || return 0
  if [[ ${VTOK_KINDS[0]} != word ]]; then redirect_only_sources; return 0; fi
  base=${VTOKS[0]##*/}
  case $base in
    dd)
      (( unresolved )) && deny "Shell-expanded file operands cannot be checked safely. Use literal paths with /token-shunt:bulk-reader."
      TOKS=("${VTOKS[@]}"); TOK_KINDS=("${VTOK_KINDS[@]}")
      ( pass() { exit 0; }; run_dd ) || exit $? ;;
    head|tail)
      stage_full_reader "$base" "$unresolved" ;;
  esac
  if is_full_reader "$base"; then
    stage_full_reader "$base" "$unresolved"
  elif is_grep_reader "$base"; then
    TOKS=("${VTOKS[@]}"); TOK_KINDS=("${VTOK_KINDS[@]}")
    grep_output_is_bounded || stage_full_reader "$base" "$unresolved"
  elif is_interpreter "$base"; then
    TOKS=("${VTOKS[@]}"); TOK_KINDS=("${VTOK_KINDS[@]}")
    inner=$(shell_program "$base") && (( BASH_DEPTH < BASH_DEPTH_MAX )) \
      && { check_shell_program "$inner"; return 0; }
    interpreter_files "$base" && check_files_full "$base"
  elif [[ $base == xargs || $base == find ]]; then
    TOKS=("${VTOKS[@]}"); TOK_KINDS=("${VTOK_KINDS[@]}")
    [[ $base == xargs ]] && run_xargs || run_find_exec
  fi
}

stage_full_reader() { # base, unresolved-expansion flag
  (( ${FS_UNCERTAIN:-0} )) && deny "A command in this Bash call may change reader files before execution. Separate file preparation and reading into different Bash calls, then use /token-shunt:bulk-reader if needed."
  (( $2 )) && deny "Shell-expanded file operands cannot be checked safely. Use literal paths with /token-shunt:bulk-reader."
  (( ${CD_UNCERTAIN:-0} )) && deny "A preceding cd has an unresolved destination or redirection. Use absolute file paths in a separate Bash call."
  TOKS=("${VTOKS[@]}"); TOK_KINDS=("${VTOK_KINDS[@]}"); collect_file_args; check_files_full "$1"
}

# For an explicit side output, retain head/tail's own output bound. The
# subshell contains run_head_tail's terminating pass without recording a
# premature whole-hook pass; a deny keeps its normal JSON and log entry.
check_stage_output() {
  local base verdict CMD_EXPANSION
  scan_ops "$1"; CMD_EXPANSION=$S_EXPANSION
  tokenize "$1"; strip_vars
  ((${#VTOKS[@]})) || return 0
  base=${VTOKS[0]##*/}
  case $base in
    head|tail)
      (( ${CD_UNCERTAIN:-0} )) && deny 'A preceding cd cannot be resolved safely.'
      verdict=$(
        pass() { exit 0; }
        TOKS=("${VTOKS[@]}"); TOK_KINDS=("${VTOK_KINDS[@]}")
        run_head_tail
      )
      if [[ -n $verdict ]]; then printf '%s\n' "$verdict"; exit 0; fi ;;
    *) check_stage_full "$1" ;;
  esac
}

# Track only a leading chain of literal cd commands in a simple command list.
# Never evaluate shell text. Conditional branches, background jobs, grouping,
# expansions, and cd after another command remain outside this limited parser.
track_literal_cd() {
  local raw=$1 target
  tokenize "$raw"; strip_vars
  # Losing the ability to resolve cd must not lose the fact that it may
  # change cwd. Retain uncertainty across all subsequent command segments.
  if [[ ${VTOKS[0]-} == cd ]]; then CD_UNCERTAIN=1; fi
  (( TRACK_CD )) || return 0
  if (( ${#TOKS[@]} == 3 )) && [[ ${TOKS[0]} == cd && ${TOKS[1]} == -- ]]; then
    target=${TOKS[2]}
  elif (( ${#TOKS[@]} == 2 )) && [[ ${TOKS[0]} == cd ]]; then
    target=${TOKS[1]}
  else
    TRACK_CD=0; return 0
  fi
  # Reject even quoted expansion characters rather than pretending to expand.
  # Bare option operands, HOME/OLDPWD, CDPATH, and shell redirections are not
  # inferred. Explicit relative/absolute directory operands are resolved by cd.
  case $raw in *'$'*|*'`'*|*'\'*|*'~'*|*'*'*|*'?'*|*'['*|*'<'*|*'>'*) TRACK_CD=0; return 0;; esac
  [[ -n $target && $target != -* ]] || { TRACK_CD=0; return 0; }
  if [[ -n ${CDPATH-} ]]; then
    case $target in /*|./*|../*|.|..) ;; *) TRACK_CD=0; return 0;; esac
  fi
  # A failed cd leaves the working directory unchanged. Following segments
  # still receive the existing conservative full-file check.
  CDPATH= builtin cd -- "$target" 2>/dev/null || TRACK_CD=0
  CD_UNCERTAIN=0
}

# --- common 5-6 / §10 decision tree ---
# Order (§10-4): compound split runs BEFORE pipe / redirect early-pass.
# `$(...)` / backticks mark a segment uninterpretable (its own tokens are not
# trusted) but never exempt operator scanning — other segments still get
# checked at full thresholds.
scan_ops "$cmd"
# Process substitutions can run independent readers and side outputs. Their
# nested shell programs are outside this lexer; never grant an early pass.
(( S_PROCESS )) && deny "Process substitution cannot be checked safely. Use separate commands with literal file paths."
CMD_EXPANSION=$S_EXPANSION
preflight_cuts=("${SEPS[@]}" "${PIPES[@]}")
# Cuts must retain source order when lists contain pipelines.
if ((${#preflight_cuts[@]})); then
  mapfile -t preflight_cuts < <(printf '%s\n' "${preflight_cuts[@]}" | sort -n)
  split_at "$cmd" "${preflight_cuts[@]}"
  for preflight_stage in "${SPLIT[@]}"; do check_command_expansion "$preflight_stage"; done
else
  check_command_expansion "$cmd"
fi
scan_ops "$cmd"
FS_UNCERTAIN=0

if ((${#SEPS[@]})); then
  TRACK_CD=1
  # A cd in a branch/subshell/pipeline must not change the inspection cwd.
  # Disable tracking for such lists instead of guessing their shell semantics.
  tokenize "$cmd"
  for ((token_i=0; token_i<${#TOKS[@]}; token_i++)); do
    [[ ${TOK_KINDS[token_i]} == operator && ( ${TOKS[token_i]} == '(' || ${TOKS[token_i]} == ')' ) ]] && TRACK_CD=0
  done
  # Brace grouping is outside the parser; quoted braces in paths are harmless.
  (( CMD_EXPANSION )) && TRACK_CD=0
  for sep in "${SEPS[@]}"; do
    pos=${sep%%:*}; len=${sep##*:}; op=${cmd:pos:len}
    case $op in '||'|'&') TRACK_CD=0;; esac
  done
  split_at "$cmd" "${SEPS[@]}"
  segments=("${SPLIT[@]}")
  for seg in ${segments[@]+"${segments[@]}"}; do
    scan_ops "$seg"
    ((${#PIPES[@]})) && TRACK_CD=0
    track_literal_cd "$seg"
    if ((${#PIPES[@]})); then
      split_at "$seg" "${PIPES[@]}"
      stages=("${SPLIT[@]}")
    else
      stages=("$seg")
    fi
    # Pipeline siblings run concurrently: even a later stage can replace a file.
    if ((${#stages[@]} > 1)); then
      for stage in "${stages[@]}"; do stage_may_mutate "$stage" && FS_UNCERTAIN=1; done
    fi
    for stage in ${stages[@]+"${stages[@]}"}; do
      check_stage_full "$stage"
      stage_may_mutate "$stage" && FS_UNCERTAIN=1
    done
  done
  pass
fi

if ((${#PIPES[@]})); then
  split_at "$cmd" "${PIPES[@]}"
  bounded_stages=("${SPLIT[@]}")
  bounded_connectors=("${PIPES[@]}")
  for stage in "${bounded_stages[@]}"; do stage_may_mutate "$stage" && FS_UNCERTAIN=1; done
  last_idx=$(( ${#SPLIT[@]} - 1 ))
  scan_ops "${SPLIT[last_idx]}"
  tail_uninterp=$S_UNINTERP
  tokenize "${SPLIT[last_idx]}"
  # No interpretable limiter: inspect every supported stage.
  if (( tail_uninterp )) || (( !${#TOKS[@]} )); then
    for stage in "${bounded_stages[@]}"; do check_stage_output "$stage"; done
    pass
  fi
  strip_vars
  base=''
  ((${#VTOKS[@]})) && base=${VTOKS[0]##*/}
  case $base in
    head|tail)
      TOKS=("${VTOKS[@]}"); TOK_KINDS=("${VTOK_KINDS[@]}")
      if pipe_tail_ok; then
        # A byte bound applies only to output that actually reaches this stage.
        # Explicit side outputs require each source's own output-size check.
        last_bound=-1
        for ((stage_idx=0; stage_idx<last_idx; stage_idx++)); do
          if pipe_stage_byte_bound "${bounded_stages[stage_idx]}"; then last_bound=$stage_idx; fi
          cut=${bounded_connectors[stage_idx]}; pos=${cut%%:*}; len=${cut##*:}
          if pipe_stage_bypasses_limit "${bounded_stages[stage_idx]}" "${cmd:pos:len}"; then
            # Check each side output immediately: a later limiter must not
            # excuse an earlier leak. A proven stdin byte bound already
            # limits earlier sources; inspect only newer explicit inputs.
            for ((source_idx=last_bound+1; source_idx<=stage_idx; source_idx++)); do
              check_stage_output "${bounded_stages[source_idx]}"
            done
          fi
        done
        pass
      elif pipe_tail_line_bound; then
        # A line cap bounds grep, whose output is already only matches; every
        # other reader still has to answer for the whole file it prints.
        TAIL_LINE_BOUND=1
        for stage in "${bounded_stages[@]}"; do check_stage_output "$stage"; done
        pass
      else
        deny "Piped '$base' output has no byte bound; use 'head -c N file' / 'tail -c N file' with explicit bytes or /token-shunt:bulk-reader."
      fi ;;
    cat|tee|less|more)
      for stage in "${bounded_stages[@]}"; do check_stage_output "$stage"; done
      pass ;;
    *)
      # An unknown transformer is no proof of bounded output. Inspect every
      # supported reader, including explicit files on intermediate stages.
      for stage in "${bounded_stages[@]}"; do check_stage_output "$stage"; done
      pass ;;
  esac
fi

if (( CLEAN_GT && ! SPECIAL_GT && S_UNINTERP == 0 )); then
  pass   # single interpretable command writing stdout to a file
fi

tokenize "$cmd"; strip_vars
((${#VTOKS[@]})) || pass
base=${VTOKS[0]##*/}
TOKS=("${VTOKS[@]}"); TOK_KINDS=("${VTOK_KINDS[@]}")
expansion_guard() {
  (( CMD_EXPANSION )) && deny "Shell-expanded file operands cannot be checked safely. Use literal paths with /token-shunt:bulk-reader."
  return 0
}
case $base in
  head|tail) expansion_guard; run_head_tail ;;
  dd)        expansion_guard; run_dd ;;
esac
if is_full_reader "$base"; then
  expansion_guard; collect_file_args; check_files_full "$base"; pass
elif is_grep_reader "$base"; then
  grep_output_is_bounded && pass
  expansion_guard; collect_file_args; check_files_full "$base"; pass
elif is_interpreter "$base"; then
  expansion_guard
  inner=$(shell_program "$base") && (( BASH_DEPTH < BASH_DEPTH_MAX )) \
    && { check_shell_program "$inner"; pass; }
  interpreter_files "$base" && check_files_full "$base"
  pass
elif [[ $base == xargs ]]; then
  expansion_guard; run_xargs; pass
elif [[ $base == find ]]; then
  run_find_exec; pass
fi
pass
