#!/usr/bin/env python3
"""PreToolUse entry point: refuse a full read once the session is over budget.

The decision lives in `intake_ledger`. Registered in hooks.json on PreToolUse
for Read, after check-delegated-read: those two refuse different things, a
delegated path and an already-spent session, and the path rule is the older
and the more specific.

`--bash` answers the same question for a Bash call that check-bash-read has
already recognised as a reader. That script owns the classification; this
one never parses a command line.

Exits 0 whatever happens. A ledger that cannot read its own state denies
nothing, so a failure here never blocks a read.
"""
import sys

import intake_ledger

if __name__ == '__main__':
    try:
        which = 'bash' if '--bash' in sys.argv[1:] else 'read'
        sys.exit(intake_ledger.main(which))
    except Exception:
        sys.exit(0)
