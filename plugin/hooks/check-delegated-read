#!/usr/bin/env python3
"""PreToolUse entry point: refuse the parent a path already with a worker.

The decision lives in `delegated_paths`. Registered in hooks.json on
PreToolUse for Read, after check-file-size: that hook passes a targeted Read
by design for the edit contract, and this one closes it for delegated paths.

Exits 0 whatever happens. A lock that cannot read its own state denies
nothing, so a failure here never blocks a Read.
"""
import sys

import delegated_paths

if __name__ == '__main__':
    try:
        sys.exit(delegated_paths.main('read'))
    except Exception:
        sys.exit(0)
